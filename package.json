{
  "name": "@zephyrex/auth",
  "version": "0.0.1-alpha.1",
  "description": "Authentication components for Zephyrex Framework — login, register, OAuth2, MFA, user/team management.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint-fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ratchet:update": "node scripts/lint-ratchet.mjs --update",
    "prettier": "prettier .",
    "prettier-fix": "prettier --write .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "fix": "prettier --write . && eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:ratchet:update": "node scripts/typecheck-ratchet.mjs --update",
    "symmetry": "node scripts/coverage-symmetry.mjs",
    "symmetry:ratchet": "node scripts/symmetry-ratchet.mjs",
    "symmetry:ratchet:update": "node scripts/symmetry-ratchet.mjs --update",
    "js-coverage": "node scripts/js-coverage.mjs",
    "js-coverage:ratchet": "node scripts/js-coverage-ratchet.mjs",
    "js-coverage:ratchet:update": "node scripts/js-coverage-ratchet.mjs --update",
    "knip": "knip",
    "knip:ratchet": "node scripts/knip-ratchet.mjs",
    "knip:ratchet:update": "node scripts/knip-ratchet.mjs --update",
    "deps": "depcruise --config .dependency-cruiser.cjs src",
    "deps:ratchet": "node scripts/depcruise-ratchet.mjs",
    "deps:ratchet:update": "node scripts/depcruise-ratchet.mjs --update",
    "type-coverage": "type-coverage --detail",
    "type-coverage:ratchet": "node scripts/type-coverage-ratchet.mjs",
    "type-coverage:ratchet:update": "node scripts/type-coverage-ratchet.mjs --update",
    "strict:ratchet": "node scripts/strict-ratchet.mjs",
    "strict:ratchet:update": "node scripts/strict-ratchet.mjs --update",
    "test:typecheck:ratchet": "node scripts/test-typecheck-ratchet.mjs",
    "test:typecheck:ratchet:update": "node scripts/test-typecheck-ratchet.mjs --update",
    "important:ratchet": "node scripts/important-ratchet.mjs",
    "important:ratchet:update": "node scripts/important-ratchet.mjs --update",
    "css:ratchet": "node scripts/css-ratchet.mjs",
    "css:ratchet:update": "node scripts/css-ratchet.mjs --update",
    "biome:ratchet": "node scripts/biome-ratchet.mjs",
    "biome:ratchet:update": "node scripts/biome-ratchet.mjs --update",
    "animation:coverage": "node scripts/animation-coverage.mjs",
    "animation:ratchet": "node scripts/animation-ratchet.mjs",
    "animation:ratchet:update": "node scripts/animation-ratchet.mjs --update",
    "theme:coverage": "node scripts/theme-coverage.mjs",
    "theme:ratchet": "node scripts/theme-ratchet.mjs",
    "theme:ratchet:update": "node scripts/theme-ratchet.mjs --update",
    "size-limit": "size-limit",
    "lockfile:validate": "node scripts/lockfile-validate.mjs",
    "test": "vitest run",
    "check": "pnpm lockfile:validate && pnpm lint:ratchet && pnpm typecheck:ratchet && pnpm symmetry:ratchet && pnpm js-coverage:ratchet && pnpm knip:ratchet && pnpm deps:ratchet && pnpm type-coverage:ratchet && pnpm strict:ratchet && pnpm test:typecheck:ratchet && pnpm important:ratchet && pnpm css:ratchet && pnpm biome:ratchet && pnpm animation:ratchet && pnpm theme:ratchet && pnpm size-limit && pnpm test",
    "compile": "rm -rf dist tsconfig.compile.tsbuildinfo && tsc -p tsconfig.compile.json && tsc-alias -p tsconfig.compile.json --resolve-full-paths",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "prepack": "pnpm compile",
    "precommit": "npx prettier --check . && pnpm compile && pnpm verify:dist && pnpm check",
    "build": "pnpm compile && pnpm typecheck:ratchet",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook-build": "storybook build",
    "storybook-deploy": "storybook build && gh-pages -d storybook-static",
    "test:storybook:integration": "sh ./scripts/run-storybook-playwright-tests.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/auth.git"
  },
  "keywords": [
    "react",
    "nextjs",
    "components"
  ],
  "author": "Jameson R Grieve",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/JamesonRGrieve/auth/issues"
  },
  "homepage": "http://jamesonrgrieve.github.io/auth",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@jgrieve/forms": "^0.0.1-alpha.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookies-next": "^6.1.1",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.48.0",
    "md5": "^2.3.0",
    "motion": "^12.38.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-qr-code": "^2.2.0",
    "react-simple-oauth2-login": "^0.5.4",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod2gql": "^0.1.0-alpha.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^12.1.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/md5": "^2.3.6",
    "@types/node": "^25.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-simple-oauth2-login": "^0.5.5",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.6.1",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-use-extend-native": "^0.7.3",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-security": "^4.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.14.5",
    "knip": "^6.38.0",
    "next": "^16.3.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^12.1.0",
    "storybook": "^10.6.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsc-alias": "^1.9.5",
    "type-coverage": "^2.30.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.6.5"
  },
  "dependenciesMeta": {
    "@jgrieve/forms": {
      "injected": true
    },
    "zod2gql": {
      "injected": true
    }
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  }
}
